# Copy to backend/.env and fill in. Never commit the real .env.
# Everything below is optional: with no .env at all the backend boots, stores data
# in backend/data/, and answers every endpoint. You only need a key to use the AI.

# --- Storage ---
# SQLite file. Created automatically.
# DB_PATH=./data/automata.db
# Where the database and the generated vault key live.
# DATA_DIR=./data

# --- Credentials vault ---
# Fernet key that encrypts saved credentials. Leave unset and one is generated
# once into DATA_DIR/.creds_secret (back that file up with the database).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDS_SECRET=

# --- AI providers ---
# Pick ANY of these; the app's provider selector chooses which one is used.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# Generic fallback used for whichever provider is selected.
# LLM_API_KEY=
# Override the endpoint (Azure OpenAI, OpenRouter, a proxy, ...).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Default model when the app has not chosen one.
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=2048

# --- Payments ---
# open (default) = self-hosted, every feature unlocked, no RevenueCat needed.
# revenuecat     = the paid app: the server checks the 'pro' entitlement and
#                  fails closed, so without the key everyone is Free.
BILLING_MODE=open
# REVENUECAT_SECRET_KEY=sk_...
# PRO_CACHE_SECONDS=300
# REVENUECAT_API_BASE=https://api.revenuecat.com

# --- Free plan limits (only apply in revenuecat mode; keep in sync with frontend/src/revenuecat.tsx) ---
FREE_WORKFLOW_LIMIT=3
FREE_AGENT_DAILY=10

# --- Cost protection: hard daily caps per device, for every plan ---
# Applies even when BILLING_MODE=open, so one device cannot drain your API budget.
# Server-paid LLM calls (each agent round and each AI step counts as one)
DAILY_LLM_CAP=300
# Python code-step executions
DAILY_CODE_CAP=200

# --- CORS ---
# Comma-separated origins, or * for any (default).
# CORS_ORIGINS=*
