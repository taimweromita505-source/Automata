# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=automata
# Fernet key that encrypts the credentials vault. Generate once and keep it stable:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDS_SECRET=
# Emergent universal LLM key (server-paid AI calls for the agent and AI steps)
EMERGENT_LLM_KEY=

# --- Payments (server-side Pro check) ---
# RevenueCat secret API key (v1, starts with sk_). Without it every device is treated as Free.
REVENUECAT_SECRET_KEY=
# How long a Pro/Free answer from RevenueCat is cached, in seconds
PRO_CACHE_SECONDS=300
# Only for tests / mocks; leave unset in production
# REVENUECAT_API_BASE=https://api.revenuecat.com

# --- Free plan limits (keep in sync with frontend/src/revenuecat.tsx) ---
FREE_WORKFLOW_LIMIT=3
FREE_AGENT_DAILY=10

# --- Cost protection: hard daily caps per device, for every plan including Pro ---
# Server-paid LLM calls (each agent round and each AI step counts as one)
DAILY_LLM_CAP=300
# Python code-step executions
DAILY_CODE_CAP=200
