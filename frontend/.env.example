# Copy to frontend/.env. These are public (bundled into the app); never put secret keys here.

# Where the Automata backend lives.
# On a phone, "localhost" means the phone: use your machine's LAN IP instead,
# e.g. http://192.168.1.20:8001, or your own domain if you put one in front.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# RevenueCat public SDK keys — optional. Leave these empty for a self-hosted backend
# that does not sell the Pro subscription (BILLING_MODE=open); the app then takes
# the plan from the server's /api/plan and shows Pro.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
